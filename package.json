{
  "name": "arco",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:recorder": "bash native/build-recorder.sh",
    "build:deepgram": "bash native/build-deepgram-transcriber.sh",
    "build:transcriber": "bash native/build-local-transcriber.sh",
    "build:native": "pnpm build:recorder && pnpm build:deepgram && pnpm build:transcriber",
    "icon:generate": "swift native/generate-app-icon.swift public/arco-icon.png public/arco-app-icon.png && tauri icon public/arco-app-icon.png && cp src-tauri/icons/32x32.png public/favicon.png && cp src-tauri/icons/ios/AppIcon-60x60@3x.png public/apple-touch-icon.png",
    "test:transcriber": "swift run --package-path native/local-transcriber -c debug arco-transcription-selftest",
    "desktop": "pnpm build:native && tauri dev",
    "desktop:build": "pnpm build:native && tauri build",
    "desktop:package": "bash native/package-local-app.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm test && pnpm test:transcriber && pnpm build",
    "design:detect": "impeccable detect src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "impeccable": "^3.2.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
