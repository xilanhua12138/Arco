# Do not commit a real key. Prefer exporting this in the shell that launches Arco.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANG=zh-Hans
# Bounded reconnect buffer; runtime clamps this to 1-300 seconds.
ARCO_AUDIO_BUFFER_SECONDS=60
# Used by the original Agent Skill scripts; init.sh can refresh these values.
ARCO_MIC_DEVICE_ID=
ARCO_MIC_DEVICE_NAME=
