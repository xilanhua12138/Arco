{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Arco",
  "mainBinaryName": "Arco",
  "version": "0.2.3",
  "identifier": "app.arco.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:native && pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Arco",
        "theme": "Light",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 27,
          "y": 26
        },
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../native/runtime": "native"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
